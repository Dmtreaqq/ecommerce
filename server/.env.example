NODE_ENV=development


PORT=3000

# Allowed CORS origin. Leave unset to allow any localhost port.
# CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

IS_DB_SSL=false

IS_DB_LOGGING=false

# Signing keys for the access and refresh JWTs. Must differ from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (15 minutes) and refresh token lifetime (14 days).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Send auth cookies with the Secure flag. Must be true in production (HTTPS),
# false for plain-HTTP localhost development.
IS_COOKIE_SECURE=false
